[Unit]
Description=Cloudflare Tunnel for Connect Four (c4.specialcast.win)
Documentation=file:///home/shawaz/code/connect-four/README.md
After=network-online.target connect-four.service
Wants=network-online.target
# Deliberately a SEPARATE tunnel (f7b84873) from eam-sync (9862090c).
# ~/.cloudflared/config.yml pins the eam-sync tunnel and ends in a
# http_status:404 catch-all, so anything that picks it up serves eam-sync's
# ingress instead. --config here keeps the two fully isolated.

[Service]
Type=simple
ExecStart=/etc/profiles/per-user/shawaz/bin/cloudflared --config /home/shawaz/.cloudflared/connect-four.yml tunnel run
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=default.target
